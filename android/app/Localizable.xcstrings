    "Choose how Swipt gets the access it needs to automate this device." : {
      "comment" : "Message on the first-launch page, above the choice between Shizuku and Root.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك اختيار الطريقة التي يحصل بها Swipt على الوصول الذي يحتاجه لأتمتة هذا الجهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете как Swipt да получава достъпа, необходим за автоматизиране на това устройство."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ডিভাইস অটোমেট করার জন্য প্রয়োজনীয় অ্যাক্সেস Swipt কীভাবে পাবে তা বেছে নিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria com obté l’app Swipt l’accés que necessita per automatitzar aquest dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, jak aplikace Swipt získá přístup, který potřebuje k automatizaci tohoto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, hvordan Swipt får den adgang, det skal bruge for at automatisere denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wie Swipt den Zugriff erhält, den es zum Automatisieren dieses Geräts benötigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε πώς θα αποκτά το Swipt την πρόσβαση που χρειάζεται για να αυτοματοποιεί αυτήν τη συσκευή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cómo obtiene Swipt el acceso que necesita para automatizar este dispositivo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cómo Swipt obtiene el acceso que necesita para automatizar este dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse, miten Swipt saa käyttöoikeudet, joita se tarvitsee tämän laitteen automatisointiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez comment Swipt obtient l’accès nécessaire pour automatiser cet appareil."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez comment l’application Swipt obtient l’accès nécessaire pour automatiser cet appareil."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ ડિવાઇસને ઑટોમેટ કરવા માટે જરૂરી ઍક્સેસ Swiptને કેવી રીતે મળે તે પસંદ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לבחור את האופן שבו Swipt יקבל את הגישה הדרושה לו כדי לבצע אוטומציה של המכשיר הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि इस डिवाइस को ऑटोमेट करने के लिए Swipt को ज़रूरी ऐक्सेस कैसे मिले।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite kako će aplikacija Swipt dobiti pristup koji joj je potreban za automatizaciju ovog uređaja."
          }
        },
        "hu" : {
          "stringUnit" : {
