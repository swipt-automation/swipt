          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä vain englannin kielen kirjaimia, numeroita, välilyöntejä ja tavallisia välimerkkejä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez uniquement des lettres de l’alphabet anglais, des chiffres, des espaces et la ponctuation standard."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
