    "Use only English letters, digits, spaces, and standard punctuation." : {
      "comment" : "Error below the field in the Screen lock PIN or password dialog when the PIN or password contains characters that Swipt can’t type.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم الأحرف الإنجليزية والأرقام والمسافات وعلامات الترقيم القياسية فقط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използвайте само букви от английската азбука, цифри, интервали и стандартни препинателни знаци."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু ইংরেজি অক্ষর, সংখ্যা, স্পেস এবং সাধারণ বিরামচিহ্ন ব্যবহার করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fes servir només lletres de l’alfabet anglès, números, espais i signes de puntuació estàndard."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používejte jen písmena anglické abecedy, číslice, mezery a běžná interpunkční znaménka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug kun engelske bogstaver, tal, mellemrum og almindelige tegnsætningstegn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende nur englische Buchstaben, Ziffern, Leerzeichen und gängige Satzzeichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε μόνο γράμματα του αγγλικού αλφαβήτου, αριθμούς, κενά και τυπικά σημεία στίξης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa solo letras del alfabeto inglés, números, espacios y signos de puntuación estándar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
