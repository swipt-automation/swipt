  "minimumIOSVersion": 17.4,
  "minimumAndroidSDK": 34,
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/swipt-automation/swipt.git",
    "directory": "api"
  },
  "type": "module",
  "exports": {
