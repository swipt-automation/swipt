+  /// The identifier in the names of the native view classes registered for this app context.
+  /// React Native never forgets a registered component name, while `appIdentifier` counts up
+  /// forever, so an app context can take a reusable one with `useReusableViewIdentifier()`;
+  /// otherwise it is `appIdentifier`.
+  @objc
+  public var viewIdentifier: String? {
+    return reusableViewIdentifier.withLock { $0?.string } ?? appIdentifier
+  }
+
+  private let reusableViewIdentifier = Mutex<ReusableViewIdentifier?>(nil)
+
+  /// Gives this app context the lowest view identifier, counting from 1, that no other living app
+  /// context holds, and returns it. The identifier is freed with the app context.
+  @objc
+  @discardableResult
+  public func useReusableViewIdentifier() -> String {
+    return reusableViewIdentifier.withLock { identifier in
+      let reusable = identifier ?? ReusableViewIdentifier()
+      identifier = reusable
+      return reusable.string
+    }
+  }
+
   /**
