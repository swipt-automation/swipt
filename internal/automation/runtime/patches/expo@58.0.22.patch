+// `ExpoReactDelegate` holds its factory strongly: expo-modules-core 58.0.29,
+// ios/ReactDelegates/ExpoReactDelegate.swift:9.
+private final class WeakReactNativeFactory: ExpoReactNativeFactoryProtocol {
+  private weak var factory: ExpoReactNativeFactory?
+
+  init(_ factory: ExpoReactNativeFactory) {
+    self.factory = factory
+  }
+
+  func recreateRootView(
+    withBundleURL: URL?,
+    moduleName: String?,
+    initialProps: [AnyHashable: Any]?,
+    launchOptions: [AnyHashable: Any]?
+  ) -> UIView {
+    guard let factory else {
+      fatalError("recreateRootView: The ExpoReactNativeFactory was deallocated")
+    }
+    return factory.recreateRootView(withBundleURL: withBundleURL, moduleName: moduleName, initialProps: initialProps, launchOptions: launchOptions)
+  }
+}
