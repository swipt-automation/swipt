        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वचालित अनलॉक सक्षम करें, ताकि आपका डिवाइस लॉक होने पर Swipt उसे अपने आप अनलॉक कर सके।"
