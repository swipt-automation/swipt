    "Turns the service of a swiplet on or off, and returns whether it’s on afterwards." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشغّل خدمة Swiplet أو يوقفها، ثم يُرجع ما إذا كانت الخدمة قيد التشغيل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включва или изключва услугата на Swiplet и връща дали тя е включена след това."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো Swiplet-এর পরিষেবা চালু বা বন্ধ করে, এবং তারপর পরিষেবাটি চালু আছে কি না তা ফেরত দেয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa o desactiva el servei d’un Swiplet i indica si després queda activat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapne nebo vypne službu Swipletu a vrátí, zda je poté zapnutá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår tjenesten i en Swiplet til eller fra og returnerer, om den er slået til bagefter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviert oder deaktiviert den Dienst eines Swiplets und gibt zurück, ob er danach aktiviert ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιεί ή απενεργοποιεί την υπηρεσία ενός Swiplet και επιστρέφει αν είναι ενεργή στη συνέχεια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa o desactiva el servicio de un Swiplet y devuelve si queda activado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa o desactiva el servicio de un Swiplet y devuelve si queda activado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ottaa Swipletin palvelun käyttöön tai poistaa sen käytöstä ja palauttaa tiedon siitä, onko palvelu sen jälkeen käytössä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active ou désactive le service d’un Swiplet et indique s’il est ensuite activé."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active ou désactive le service d’un Swiplet et indique s’il est ensuite activé."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipletની સેવા ચાલુ કે બંધ કરે છે અને પછી તે ચાલુ છે કે નહીં તે પરત કરે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפעיל או מכבה את השירות של Swiplet, ומחזיר אם הוא מופעל לאחר מכן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी Swiplet की सेवा को चालू या बंद करता है, और लौटाता है कि उसके बाद सेवा चालू है या नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uključuje ili isključuje Swiplet uslugu i vraća je li nakon toga uključena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be- vagy kikapcsolja egy Swiplet szolgáltatását, és visszaadja, hogy utána be van-e kapcsolva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyalakan atau mematikan layanan Swiplet, dan mengembalikan apakah layanan tersebut menyala setelahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva o disattiva il servizio di uno Swiplet e indica se in seguito risulta attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipletのサービスをオンまたはオフにし、その後サービスがオンになっているかどうかを返します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swiplet қызметін қосады немесе өшіреді, содан кейін қызметтің қосулы-қосулы емесін қайтарады."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipletನ ಸೇವೆಯನ್ನು ಆನ್ ಅಥವಾ ಆಫ್ ಮಾಡುತ್ತದೆ ಮತ್ತು ನಂತರ ಅದು ಆನ್ ಆಗಿದೆಯೇ ಎಂಬುದನ್ನು ಹಿಂತಿರುಗಿಸುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swiplet의 서비스를 켜거나 끄고, 그 후 서비스가 켜져 있는지 여부를 반환합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įjungia arba išjungia „Swiplet” paslaugą ir grąžina, ar ji po to įjungta."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒരു Swiplet-ന്റെ സർവീസ് ഓണാക്കുകയോ ഓഫാക്കുകയോ ചെയ്യുന്നു, തുടർന്ന് അത് ഓണാണോ എന്ന് നൽകുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swiplet ची सेवा सुरू किंवा बंद करते आणि त्यानंतर ती सुरू आहे की नाही हे परत करते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghidupkan atau mematikan perkhidmatan Swiplet dan mengembalikan sama ada ia hidup selepas itu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår tjenesten i en Swiplet på eller av, og returnerer om den er på etterpå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakelt de dienst van een Swiplet in of uit en geeft terug of de dienst daarna is ingeschakeld."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏକ Swiplet ର ସେବା ଚାଲୁ କିମ୍ବା ବନ୍ଦ କରେ ଏବଂ ତା’ପରେ ଏହା ଚାଲୁ ଅଛି କି ନାହିଁ ତାହା ଫେରାଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕਿਸੇ Swiplet ਦੀ ਸੇਵਾ ਨੂੰ ਚਾਲੂ ਜਾਂ ਬੰਦ ਕਰਦਾ ਹੈ, ਅਤੇ ਵਾਪਸ ਦੱਸਦਾ ਹੈ ਕਿ ਉਸ ਤੋਂ ਬਾਅਦ ਸੇਵਾ ਚਾਲੂ ਹੈ ਜਾਂ ਨਹੀਂ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącza lub wyłącza usługę Swipletu i zwraca informację, czy jest ona potem włączona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativa ou desativa o serviço de um Swiplet e retorna se ele fica ativado depois."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativa ou desativa o serviço de um Swiplet e devolve se este fica ativo depois."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activează sau dezactivează serviciul unui Swiplet și returnează dacă acesta este activat ulterior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включает или выключает службу Swiplet и возвращает, включена ли она после этого."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapne alebo vypne službu Swiplet a vráti, či je potom zapnutá."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vklopi ali izklopi storitev Swiplet in vrne, ali je nato vklopljena."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår på eller av tjänsten i en Swiplet och returnerar om den är på efteråt."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipletஇன் சேவையை ஆன் அல்லது ஆஃப் செய்து, அதன் பிறகு அது ஆனில் உள்ளதா என்பதை வழங்குகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swiplet సర్వీస్‌ను ఆన్ లేదా ఆఫ్ చేసి, ఆ తర్వాత అది ఆన్‌లో ఉందో లేదో అందిస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดหรือปิดบริการของ Swiplet แล้วส่งคืนว่าบริการเปิดอยู่หรือไม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir Swiplet’in servisini açar veya kapatır ve ardından servisin açık olup olmadığını döndürür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вмикає або вимикає службу Swiplet і повертає, чи її увімкнено після цього."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کسی Swiplet کی سروس آن یا آف کرتا ہے، اور واپس کرتا ہے کہ اس کے بعد سروس آن ہے یا نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật hoặc tắt dịch vụ của Swiplet, rồi trả về việc dịch vụ có đang bật hay không."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟或關閉 Swiplet 的服務，並傳回服務之後是否已開啟。"
