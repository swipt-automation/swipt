            "value" : "ഇഷ്ടാനുസൃത ന്യൂമെറിക് കോഡിൽ 0 മുതൽ 9 വരെയുള്ള അക്കങ്ങൾ മാത്രമേ ഉൾപ്പെടുത്താനാകൂ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कस्टम संख्यात्मक कोडमध्ये फक्त 0 ते 9 हे अंक असू शकतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod angka tersuai hanya boleh mengandungi digit dari 0 hingga 9."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tilpasset tallkode kan bare inneholde sifrene 0 til 9."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een aangepaste numerieke code mag alleen de cijfers 0 tot en met 9 bevatten."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କଷ୍ଟମ୍ ନ୍ଯୂମେରିକ୍ କୋଡ୍‌ରେ କେବଳ 0 ରୁ 9 ପର୍ଯ୍ୟନ୍ତ ଅଙ୍କ ରହିପାରିବ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਵਿਉਂਤਬੱਧ ਸੰਖਿਆਤਮਕ ਕੋਡ ਵਿੱਚ ਸਿਰਫ਼ 0 ਤੋਂ 9 ਤੱਕ ਦੇ ਅੰਕ ਹੋ ਸਕਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Własny kod numeryczny może zawierać tylko cyfry od 0 do 9."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um código numérico personalizado só pode conter dígitos de 0 a 9."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um código numérico personalizado só pode conter dígitos de 0 a 9."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cod numeric personalizat poate conține doar cifre de la 0 la 9."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Произвольный цифровой код может содержать только цифры от 0 до 9."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastný číselný kód môže obsahovať iba číslice od 0 do 9."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagojena numerična koda lahko vsebuje samo števke od 0 do 9."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En anpassad numerisk kod får bara innehålla siffrorna 0 till 9."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பிரத்தியேக எண் குறியீட்டில் 0 முதல் 9 வரையிலான இலக்கங்கள் மட்டுமே இருக்க முடியும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కస్టమ్ న్యూమరిక్ కోడ్‌లో 0 నుండి 9 వరకు ఉన్న అంకెలు మాత్రమే ఉండవచ్చు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รหัสตัวเลขที่กำหนดเองใช้ได้เฉพาะตัวเลข 0 ถึง 9 เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel sayısal kod yalnızca 0 ile 9 arasındaki rakamları içerebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Власний числовий код може містити лише цифри від 0 до 9."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حسب خواہش عددی کوڈ میں صرف 0 سے 9 تک کے ہندسے شامل ہو سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mã số tùy chỉnh chỉ có thể chứa các chữ số từ 0 đến 9."
          }
        },
        "zh-HK" : {
