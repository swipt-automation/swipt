        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ക്രമീകരണം › സ്വകാര്യതയും സുരക്ഷയും › ഡെവലപ്പർ മോഡ് എന്നതിലേക്ക് പോകൂ."
          }
        },
        "mr" : {
          "stringUnit" : {
