        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Құрылғыңыз құлыпталған кезде Swipt оның құлпын автоматты түрде аша алуы үшін құлыпты автоматты түрде ашу мүмкіндігін қосыңыз."
