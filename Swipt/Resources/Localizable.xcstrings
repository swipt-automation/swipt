    "Swipt couldn’t keep waiting for Settings in the background." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر على Swipt مواصلة انتظار الإعدادات في الخلفية."
