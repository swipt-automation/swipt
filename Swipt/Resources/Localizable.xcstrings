        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyissa meg a Beállítások › Adatvédelem és biztonság › Fejlesztői mód menüt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka Pengaturan › Privasi & Keamanan › Mode Pengembang."
