    "Go to Settings › Privacy & Security › Developer Mode." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتقل إلى الإعدادات > الخصوصية والأمن > نمط المطور."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отидете в Настройки › Повери­тел­ност и си­гур­ност › Режим за разработчици."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সেটিংস › গোপনীয়তা ও সুরক্ষা › ডেভেলপার মোডে যান।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ves a Configuració › Privacitat i seguretat › Mode de desenvolupament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejděte do Nastavení › Soukromí a zabezpečení › Vývojový režim."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå til Indstillinger › Anonymitet & sikkerhed › Udviklerfunktion."
