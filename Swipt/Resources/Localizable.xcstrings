    "Automatic unlock supports English letters, numbers, spaces, and standard punctuation. Other characters aren’t supported." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يدعم فتح القفل التلقائي الأحرف الإنجليزية والأرقام والمسافات وعلامات الترقيم القياسية، ولا يدعم الأحرف الأخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматичното отключване поддържа букви от английската азбука, цифри, интервали и стандартни препинателни знаци. Други знаци не се поддържат."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্বয়ংক্রিয় আনলক ইংরেজি অক্ষর, সংখ্যা, স্পেস এবং সাধারণ বিরামচিহ্ন সমর্থন করে। অন্য কোনো অক্ষর সমর্থিত নয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desbloqueig automàtic admet lletres de l’alfabet anglès, números, espais i signes de puntuació estàndard. No s’admeten altres caràcters."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatické odemykání podporuje písmena anglické abecedy, číslice, mezery a běžná interpunkční znaménka. Jiné znaky nejsou podporovány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisk oplåsning understøtter engelske bogstaver, tal, mellemrum og almindelige tegnsætningstegn. Andre tegn understøttes ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die automatische Entsperrung unterstützt englische Buchstaben, Ziffern, Leerzeichen und gängige Satzzeichen. Andere Zeichen werden nicht unterstützt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το αυτόματο ξεκλείδωμα υποστηρίζει γράμματα του αγγλικού αλφαβήτου, αριθμούς, κενά και τυπικά σημεία στίξης. Άλλοι χαρακτήρες δεν υποστηρίζονται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic unlock supports English letters, numbers, spaces, and standard punctuation. Other characters aren’t supported."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desbloqueo automático admite letras del alfabeto inglés, números, espacios y signos de puntuación estándar. No se admiten otros caracteres."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desbloqueo automático admite letras del alfabeto inglés, números, espacios y signos de puntuación estándar. No se admiten otros caracteres."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaattinen lukituksen avaus tukee englannin kielen kirjaimia, numeroita, välilyöntejä ja tavallisia välimerkkejä. Muita merkkejä ei tueta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le déverrouillage automatique prend en charge les lettres de l’alphabet anglais, les chiffres, les espaces et la ponctuation standard. Les autres caractères ne sont pas pris en charge."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le déverrouillage automatique prend en charge les lettres de l’alphabet anglais, les chiffres, les espaces et la ponctuation standard. Les autres caractères ne sont pas pris en charge."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઑટોમેટિક અનલૉક અંગ્રેજી અક્ષરો, નંબરો, સ્પેસ અને સામાન્ય વિરામચિહ્નોને સપોર્ટ કરે છે. અન્ય અક્ષરો સપોર્ટેડ નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ביטול נעילה אוטומטי תומך באותיות באנגלית, בספרות, ברווחים ובסימני פיסוק רגילים. תווים אחרים אינם נתמכים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वचालित अनलॉक अंग्रेज़ी अक्षरों, अंकों, स्पेस और मानक विराम चिह्नों का समर्थन करता है। अन्य वर्ण समर्थित नहीं हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatsko otključavanje podržava engleska slova, brojeve, razmake i standardne interpunkcijske znakove. Ostali znakovi nisu podržani."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az automatikus feloldás az angol betűket, a számokat, a szóközt és a szokásos írásjeleket támogatja. Más karakterek nem támogatottak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka kunci otomatis mendukung huruf bahasa Inggris, angka, spasi, dan tanda baca standar. Karakter lain tidak didukung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo sblocco automatico supporta lettere dell’alfabeto inglese, numeri, spazi e punteggiatura standard. Gli altri caratteri non sono supportati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動ロック解除では、英字、数字、スペース、標準的な記号を使用できます。その他の文字はサポートされていません。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Құлыпты автоматты түрде ашу ағылшын әріптерін, сандарды, бос орындарды және стандартты тыныс белгілерін қолдайды. Басқа таңбаларға қолдау көрсетілмейді."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸ್ವಯಂಚಾಲಿತ ಅನ್‌ಲಾಕ್, ಇಂಗ್ಲಿಷ್ ಅಕ್ಷರಗಳು, ಸಂಖ್ಯೆಗಳು, ಸ್ಪೇಸ್‌ಗಳು ಮತ್ತು ಸಾಮಾನ್ಯ ವಿರಾಮ ಚಿಹ್ನೆಗಳನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ. ಇತರ ಅಕ್ಷರಗಳನ್ನು ಬೆಂಬಲಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 잠금 해제는 영문자, 숫자, 공백 및 일반 문장 부호를 지원합니다. 다른 문자는 지원되지 않습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatinis atrakinimas palaiko anglų kalbos raides, skaičius, tarpus ir įprastus skyrybos ženklus. Kiti simboliai nepalaikomi."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഓട്ടോമാറ്റിക് അൺലോക്ക് ഇംഗ്ലീഷ് അക്ഷരങ്ങൾ, അക്കങ്ങൾ, സ്പെയ്സുകൾ, സാധാരണ വിരാമചിഹ്നങ്ങൾ എന്നിവ പിന്തുണയ്ക്കുന്നു. മറ്റ് പ്രതീകങ്ങൾ പിന്തുണയ്ക്കുന്നില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
