        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεταβείτε στις Ρυθμίσεις › Απόρρητο και ασφάλεια › Λειτουργία δημιουργού."
          }
        },
        "es" : {
          "stringUnit" : {
