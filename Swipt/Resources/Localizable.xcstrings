        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಸಾಧನ ಲಾಕ್ ಆಗಿರುವಾಗ Swipt ಆ್ಯಪ್ ಅದನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಅನ್‌ಲಾಕ್ ಮಾಡುವಂತೆ, ಸ್ವಯಂಚಾಲಿತ ಅನ್‌ಲಾಕ್ ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 잠금 해제를 활성화하면 기기가 잠겨 있을 때 Swipt가 자동으로 기기의 잠금을 해제할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įjunkite automatinį atrakinimą, kad „Swipt” galėtų automatiškai atrakinti jūsų įrenginį, kai jis užrakintas."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഡിവൈസ് ലോക്ക് ചെയ്തിരിക്കുമ്പോൾ Swipt-ന് അത് സ്വയമേവ അൺലോക്ക് ചെയ്യാൻ, ഓട്ടോമാറ്റിക് അൺലോക്ക് പ്രവർത്തനക്ഷമമാക്കൂ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वयंचलित अनलॉक सक्षम करा, जेणेकरून तुमचे डिव्हाइस लॉक असताना Swipt ते आपोआप अनलॉक करू शकेल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dayakan buka kunci automatik supaya Swipt boleh membuka kunci peranti anda secara automatik apabila ia dikunci."
