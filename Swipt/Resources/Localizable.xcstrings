    "Enter a 4-digit or 6-digit passcode, or select the passcode type used by this device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل رمز دخول مكونًا من ٤ أو ٦ أرقام، أو اختر نوع رمز الدخول الذي يستخدمه هذا الجهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Въведете 4- или 6-цифрен код или изберете типа код, използван на това устройство."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 বা 6 অঙ্কের পাসকোড লিখুন, অথবা এই ডিভাইসে ব্যবহৃত পাসকোডের ধরন বেছে নিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introdueix un codi de 4 o 6 dígits, o selecciona el tipus de codi que utilitza aquest dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte čtyř- nebo šestimístný kód, nebo vyberte typ kódu, který toto zařízení používá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast en 4- eller 6-cifret adgangskode, eller vælg den type adgangskode, som denne enhed bruger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib einen 4- oder 6-stelligen Code ein oder wähle den Codetyp aus, den dieses Gerät verwendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εισαγάγετε έναν κωδικό 4 ή 6 ψηφίων ή επιλέξτε τον τύπο κωδικού που χρησιμοποιεί αυτή η συσκευή."
