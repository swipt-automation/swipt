    "Runs an action of a swiplet with the input as JSON, and returns its output as JSON." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشغّل أحد إجراءات Swiplet باستخدام إدخال بتنسيق JSON، ويُرجع ناتجه بتنسيق JSON."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изпълнява действие на Swiplet с входни данни във формат JSON и връща резултата във формат JSON."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON ইনপুট দিয়ে কোনো Swiplet-এর একটি অ্যাকশন চালায় এবং তার আউটপুট JSON হিসেবে ফেরত দেয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
