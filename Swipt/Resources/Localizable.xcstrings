        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Реттеулер › Құпиялылық және қауіпсіздік › Әзірлеуші режимі бөліміне өтіңіз."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸೆಟ್ಟಿಂಗ್ಸ್ › ಗೌಪ್ಯತೆ ಮತ್ತು ಭದ್ರತೆ › ಡೆವಲಪರ್ ಮೋಡ್ ಎಂಬಲ್ಲಿಗೆ ಹೋಗಿ."
